{
    "Console": {
        "prefix": "console",
        "description": "Console Statements",
        "body": "console.${1|log,info,warn,error,debug,assert,clear,count,countReset,table,dir,dirxml,group,groupCollapsed,groupEnd,time,timeEnd,timeLog,timeStamp,trace|}($2)$0",
        "scope": "javascript,typescript"
    },
    "Test": {
        "prefix": "test",
        "description": "Test Case",
        "body": [
            "${1|test,it,describe|}('${2:description}', () => {",
            "\t$3",
            "})",
            "$0"
        ],
        "scope": "javascript,typescript",
        "include": [
            "**/*.test.js",
            "**/*.test.ts"
        ]
    },
}
