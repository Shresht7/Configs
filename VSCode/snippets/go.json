	"Main with run func": {
		"prefix": "run",
		"body": [
		  "package main",
		  "",
		  "import (",
		  "  \"fmt\"",
		  "  \"io\"",
		  "  \"os\"",
		  ")",
		  "",
		  "func main() {",
		  "  if err := run(os.Args, os.Stdout); err != nil {",
		  "    fmt.Fprintf(os.Stderr, \"%s\\n\", err)",
		  "    os.Exit(1)",
		  "  }",
		  "}",
		  "",
		  "func run(args []string, stdout io.Writer) error {",
		  "  $1",
		  "  return nil",
		  "}"
		]
	},
