{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "github",
    "mode": "system"
  },
  "animations": true,
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "submit_scroll": "keep",
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "permissions": "prompt"
  }
}
