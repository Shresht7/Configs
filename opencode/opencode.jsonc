{
	// OpenCode Configuration
	// https://opencode.ai/v2/docs/config
	"$schema": "https://opencode.ai/config.json",
	"update": "notify",
	"permissions": [
		{
			// Deny reading .env file
			"action": "read",
			"resource": ".env",
			"effect": "deny"
		},
		{
			// Ask before accessing external directories
			"action": "external_directory",
			"resource": "*",
			"effect": "ask"
		},
		{
			// Ask permission for shell actions
			"action": "shell",
			"resource": "*",
			"effect": "ask"
		},
		{
			// Ask before using rm
			"action": "shell",
			"resource": "rm *",
			"effect": "ask"
		},
		{
			// Allow git status
			"action": "shell",
			"resource": "git status *",
			"effect": "allow"
		},
		{
			// Allow git log
			"action": "shell",
			"resource": "git log *",
			"effect": "allow"
		},
		{
			// Allow git show
			"action": "shell",
			"resource": "git show *",
			"effect": "allow"
		},
		{
			// Allow git diff
			"action": "shell",
			"resource": "git diff *",
			"effect": "allow"
		}
	],
}
