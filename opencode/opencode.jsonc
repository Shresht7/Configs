{
	// ======================
	// OPENCODE CONFIGURATION
	// ======================
	// https://opencode.ai/v2/docs/config
	"$schema": "https://opencode.ai/config.json",
	"update": "notify",
	// -----------
	// PERMISSIONS
	// -----------
	// https://opencode.ai/docs/permissions/
	"permissions": [
		{
			// Deny reading .env file
			"action": "read",
			"resource": "*.env",
			"effect": "deny"
		},
		{
			// Can ask for .env.example file
			"action": "read",
			"resource": "*.env.example",
			"effect": "ask"
		},
		{
			// Ask before accessing external directories
			"action": "external_directory",
			"resource": "*",
			"effect": "ask"
		},
		{
			// Ask permission for shell actions
			"action": "shell",
			"resource": "*",
			"effect": "ask"
		},
		{
			// Ask before using rm
			"action": "shell",
			"resource": "rm *",
			"effect": "ask"
		},
		{
			// Allow git status
			"action": "shell",
			"resource": "git status *",
			"effect": "allow"
		},
		{
			// Allow git log
			"action": "shell",
			"resource": "git log *",
			"effect": "allow"
		},
		{
			// Allow git show
			"action": "shell",
			"resource": "git show *",
			"effect": "allow"
		},
		{
			// Allow git diff
			"action": "shell",
			"resource": "git diff *",
			"effect": "allow"
		}
	],
	// --------
	// POLICIES
	// --------
	// https://opencode.ai/docs/policies/
	"policies": [
		{
			// Deny sudo usage
			"action": "tool.use",
			"resource": "shell:sudo *",
			"effect": "deny"
		}
	],
	// -------
	// WARMING
	// -------
	// https://opencode.ai/docs/warming/
	"warming": {
		"prompt": "Do not perform any work or use any tools; This is a heartbeat prompt. Reply with exactly: OK",
		"interval": "auto",
		"duration": "30 minutes"
	}
}
