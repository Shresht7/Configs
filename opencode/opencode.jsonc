{
	// OpenCode Configuration
	// https://opencode.ai/v2/docs/config
	"$schema": "https://opencode.ai/config.json",
	"update": "notify",
	"permissions": [
		{
			// Ask permission for shell actions
			"action": "shell",
			"resource": "*",
			"effect": "ask"
		},
		{
			// Allow git status
			"action": "shell",
			"resource": "git status *",
			"effect": "allow"
		},
		{
			// Allow git log
			"action": "shell",
			"resource": "git log *",
			"effect": "allow"
		},
		{
			// Allow git show
			"action": "shell",
			"resource": "git show *",
			"effect": "allow"
		},
		{
			// Allow git diff
			"action": "shell",
			"resource": "git diff *",
			"effect": "allow"
		}
	],
}
