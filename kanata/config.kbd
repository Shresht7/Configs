;; ------
;; CONFIG
;; ------

;; Documentation: https://jtroo.github.io/config.html

;; Reference: https://github.com/jtroo/kanata/blob/main/docs/config.adoc

(defcfg
  tray-icon qwerty.png                ;; Use a custom tray icon in the config folder
  icon-match-layer-name yes           ;; Use a different icon for the different layers

  concurrent-tap-hold yes             ;; Start each tap-hold's timeout when its key is pressed, rather than after the previous tap-hold expires. Speeds up overlapping dual-role keys.
  tap-hold-require-prior-idle 300     ;; Require the user to have not pressed any keys for 300ms before the tap-hold action can be triggered. This is to prevent accidental layer switches and modifier keys when typing quickly.
  chords-v2-min-idle 200              ;; The minimum amount of idle time (in ms) required before a chord can be triggered. This is to prevent accidental chords from being triggered when typing quickly. 
  
  windows-altgr cancel-lctl-press     ;; Remove the lctl press that is generated alongside ralt 
  
  ;; log-layer-changes no                ;; Don't log layer changes to the console. Has slight overhead, so it's best to keep it off unless you're debugging layer changes.
)

;; ------
;; SOURCE
;; ------

#|
The configuration file must have exactly one `defsrc`.
This defines the order of keys that the `deflayer` entries will operate on.

It should be noted that the `defsrc` entry is treated as a long sequence;
The amount of whitespace (spaces, tabs, newlines) are not relevant. You may use
spaces, tabs, or newlines however you like to visually format `defsrc` to your liking.

Reference: https://github.com/jtroo/kanata/blob/main/docs/config.adoc#defsrc
|#
(defsrc
  esc  f1  f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  calc menu
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc      ;;  ins home pgup     nlck kp/ kp* kp-
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \         ;;  del end  pgdn     kp7 kp8 kp9  kp+
  caps a    s    d    f    g    h    j    k    l    ;    '        ret        ;;                    kp4 kp5 kp6
  lsft z    x    c    v    b    n    m    ,    .    /             rsft       ;;       up           kp1 kp2 kp3  kprt
  lctl   lmet   lalt               spc            ralt    rmet    rctl       ;; left down right    kp0     kp.
)

;; ---------
;; VARIABLES
;; ---------

;; Reference: https://github.com/jtroo/kanata/blob/main/docs/config.adoc#variables

(defvar
  tap-time 100
  hold-time 200
  one-shot-time 2000
  caps-word-time 4000
)

(defhands
  (left q w e r t y a s d f g z x c v b 1 2 3 4 5 6 `)
  (right u i o p [ ] h j k l ; ' n m , . / 7 8 9 0 - = \)
)

;; ------------
;; VIRTUAL KEYS
;; ------------

(defvirtualkeys
  vctl lctl
  vsft lsft
  valt lalt
  vmet lmet
)

(defalias
  ;; Release all virtual keys
  release-all-vkeys (multi (on-release release-vkey vctl) (on-release release-vkey vsft) (on-release release-vkey valt) (on-release release-vkey vmet))

  ;; Hold down virtual keys until released
  hctl (on-press press-vkey vctl)
  hsft (on-press press-vkey vsft)
  halt (on-press press-vkey valt)
  hmet (on-press press-vkey vmet)
)

;; -------
;; ALIASES
;; -------

;; Reference: https://github.com/jtroo/kanata/blob/main/docs/config.adoc#aliases

(defalias
  ;; Layer Aliases
  qwerty (layer-switch qwerty)
  nav (layer-switch nav)
  sym (layer-switch symbols)
  lyrs (layer-switch layers)
  reload lrld

  ;; Action to toggle between the base and navigation layers
  toggle-layer (multi ins (switch 
    ((layer qwerty)) (layer-switch nav) break
    ((layer nav)) (layer-switch qwerty) break
  ))

  ;; Hyper key combination
  hyper (multi lctl lsft lalt lmet)

  ;; Holding the space key swtiches to nav layer
  spc (tap-hold-release $tap-time $hold-time spc (multi (layer-while-held nav) @release-all-vkeys))

  ;; Tapping the caps lock key sends escape. Holding it down sends left control. Double tapping it quickly toggles between the base layer and the navigation layer.
  ;; Tripple tapping it quickly will trigger caps word, and quadruple tapping will toggles the original caps lock behavior.
  cap (tap-hold-press $tap-time $hold-time (tap-dance 200 (esc @toggle-layer (caps-word $caps-word-time) caps)) lctl (require-prior-idle 0))

  ;; `Enter` behaves as is when tapped but as `RCtl` when held down
  ret (tap-hold-press $tap-time $hold-time ret rctl (require-prior-idle 0))

  ;; Holding down Right Alt behaves as Normal Alt. Tapping Right Alt toggles between the base layer and the navigation layer. Double tapping RAlt switches to the meta-layer
  ralt (tap-hold-press $tap-time $hold-time (tap-dance $tap-time (@toggle-layer @lyrs)) lalt (require-prior-idle 0))

  ;; `F12` behaves as is when tapped but as `Menu` when held down
  f12 (tap-hold-press $tap-time $hold-time f12 menu)

  ;; Bottom Row Mods
  z (tap-hold-opposite-hand-release $hold-time z lmet (same-hand ignore) (timeout hold))
  x (tap-hold-opposite-hand-release $hold-time x lalt (same-hand ignore) (timeout hold))
  c (tap-hold-opposite-hand-release $hold-time c lsft (same-hand ignore) (timeout hold))
  v (tap-hold-opposite-hand-release $hold-time v lctl (same-hand ignore) (timeout hold))
  m (tap-hold-opposite-hand-release $hold-time m rctl (same-hand ignore) (timeout hold))
  , (tap-hold-opposite-hand-release $hold-time , rsft (same-hand ignore) (timeout hold))
  . (tap-hold-opposite-hand-release $hold-time . lalt (same-hand ignore) (timeout hold))
  / (tap-hold-opposite-hand-release $hold-time / rmet (same-hand ignore) (timeout hold))

  ;; Tapping ; works normally but holding it terminates the line with a semicolon
  ; (tap-hold $tap-time $hold-time ; (multi end ;))

  ;; Holding ' switches to symbols layer
  quotes (tap-dance 150 (' S-'))
  ' (tap-hold-release $tap-time $hold-time @quotes (layer-while-held symbols))

  ;; Escape hatch to return-to-base
  rtb (multi @release-all-vkeys esc (layer-switch qwerty))
)

;; ------
;; LAYERS
;; ------

#|
The configuration must have atleast one `deflayer`. This maps how each physical key mapped
in the `defsrc` behaves when kanata runs.

Reference: https://github.com/jtroo/kanata/blob/main/docs/config.adoc#deflayer
|#
(deflayer qwerty
  @rtb f1  f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  calc menu
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc ;;  ins home pgup    nlck kp/ kp* kp-
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \ ;;  del end  pgdn    kp7 kp8 kp9  kp+
  @cap a    s    d    f    g    h    j    k    l    @;   @'       @ret ;;                    kp4 kp5 kp6
  lsft @z   @x   @c   @v   b    n    @m   @,   @.   @/            rsft ;;        up           kp1 kp2 kp3  kprt
  lctl   lmet   lalt               @spc           @ralt   rmet    rctl ;; left down right    kp0     kp.
)

;; (deflayer colemak
;;   esc  f1  f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  calc menu
;;   @grv 1    2    3    4    5    6    7    8    9    0    -    =    bspc     ins home pgup    nlck kp/ kp* kp-
;;   tab  _    _    f    p    g    j    l    u    y    ;    [    ]    @\       del end  pgdn    kp7 kp8 kp9  kp+
;;   @cap _    r    s    t    d    _    n    e    i    o    '    @ret                           kp4 kp5 kp6
;;   lsft _    _    _    _    _    k    _    ,    .    /    rsft                   up           kp1 kp2 kp3  kprt
;;   lctl lmet lalt           spc            ralt rmet rctl               left down right       kp0     kp.
;; )

;; ---------
;; NAV LAYER
;; ---------

;; The `nav` layer remaps:
;;  - the WASD and IJKL keys to the arrows keys
;;  - the Q,U and E,O keys to page up and page down respectively
;;  - The T,H and G,; keys to Home and End respectively
;;  - b to Backspace and n to Delete
;;  - The Tab key to Control-Tab
;;  - ' to f12
;;  - The Caps Lock key to Escape when tapped and Left Control when held down. Double tapping it quickly will switch to the qwerty layer.
;;  - Bottom Row Mods
(deflayer nav
  @rtb _   _    _    _    _    _    _    _    _    _    _    _    _    _
  @lyrs 1    3    9    0    5    6    7    8    2    4    _    _    _ ;;  _   _    _        _    _   _   _
  C-tab pgup up   pgdn _    home _    pgup up   pgdn @sym _    _    C-S-tab ;;   _   _    _        _   _   _    _
  @cap left down right ret  end  home left down right end  @f12     @ret ;;                      _   _   _
  _    @hmet @halt @hsft @hctl bspc del  @hctl @hsft @halt @hmet         _ ;;        _            _   _   _    _
  _      _      _                  @toggle-layer  @ralt   _       _ ;; _    _    _        _       _
)

(deflayer symbols
  @rtb _   _    _    _    _    _    _    _    _    _    _    _    _    _
  _    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  _    _    _ ;;  _   _    _        _    _   _   _
  _    @quotes _    _    _    _    _    _    _    _    _    _    _    _ ;;   _   _    _        _   _   _    _
  @qwerty S-,  [    S-[  S-9  =    ;    S-0  S-]  ]    S-.  _        _ ;;                      _   _   _
  _    lmet lalt lsft lctl C-bspc C-del rctl rsft lalt rmet          _ ;;        _            _   _   _    _
  _      _      _                  _              _       _       _ ;; _    _    _        _       _
)

;; A meta-layer that can be used to navigate to other layers or live-reload the configuration
(deflayer layers
  @rtb XX  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX ;;  XX  XX   XX       XX   XX  XX  XX
  XX   @qwerty XX   XX   @reload XX   XX   XX   XX   XX   XX   XX   XX   XX ;;        XX  XX   XX       XX  XX  XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX       XX ;;                    XX  XX  XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX            XX ;;       XX           XX  XX  XX   XX
  XX     XX     XX                 @nav           @ralt   XX      XX ;; XX   XX   XX       XX      XX
)

;; ------
;; CHORDS
;; ------

(defchordsv2
  ;; Hyper Keys
  (a s d f) @hyper 100 first-release ()
  (j k l ;) @hyper 100 first-release ()

  ;; Bottom Row Left Hand Chords
  (v c) (multi lctl lsft) 100 first-release ()
  (v x) (multi lctl lalt) 100 first-release ()
  (v z) (multi lctl lmet) 100 first-release ()
  (c x) (multi lsft lalt) 100 first-release ()
  (c z) (multi lsft lmet) 100 first-release ()
  (x z) (multi lalt lmet) 100 first-release ()
  (v c x) (multi lctl lsft lalt) 100 first-release ()
  (v c z) (multi lctl lsft lmet) 100 first-release ()
  (v x z) (multi lctl lalt lmet) 100 first-release ()
  (c x z) (multi lsft lalt lmet) 100 first-release ()
  (v c x z) @hyper 100 first-release ()

  ;; Bottom Row Right Hand Chords
  (m ,) (multi rctl rsft) 100 first-release ()
  (m .) (multi rctl ralt) 100 first-release ()
  (m /) (multi rctl rmet) 100 first-release ()
  (, .) (multi rsft ralt) 100 first-release ()
  (, /) (multi rsft rmet) 100 first-release ()
  (. /) (multi ralt rmet) 100 first-release ()
  (m , .) (multi rctl rsft ralt) 100 first-release ()
  (m , /) (multi rctl rsft rmet) 100 first-release ()
  (m . /) (multi rctl ralt rmet) 100 first-release ()
  (, . /) (multi rsft ralt rmet) 100 first-release ()
  (m , . /) @hyper 100 first-release ()
)
